{
  "manifest_version": 3,
  "name": "cdreplay link handler",
  "version": "0.1",
  "description": "Opens Chrono Divide replay links in the cdreplay app instead of the web client.",
  "content_scripts": [
    {
      "matches": [
        "https://game.chronodivide.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cdreplay@zzattack.org",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
